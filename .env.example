# Names only. Values live in the secret manager or Railway environment config (Appendix A).
DATABASE_URL=
DATABASE_READ_URL=
# worker-core only: the retention role (packages/db/roles/retention-role.sql) for retentionSweepWorkflowV1's
# activities; unset = the sweep runs on DATABASE_URL, whose application role cannot delete insert-only rows
DATABASE_URL_RETENTION=
REDIS_URL=
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=
TEMPORAL_TLS_CERT_REF=
OBJECT_STORE_BUCKET_ASSETS=
OBJECT_STORE_BUCKET_RELEASES=
OBJECT_STORE_ENDPOINT=
OBJECT_STORE_REGION=
OBJECT_STORE_ACCESS_KEY_ID=
OBJECT_STORE_SECRET_ACCESS_KEY=
# clamd host:port for upload scanning (spec 9.1); production fails closed without it
SCANNER_CLAMD_ADDRESS=
SCANNER_TIMEOUT_MS=
KMS_KEY_ID_CREDENTIALS=
# api: Google sign-in (D-03, OpenID Connect). Production fails at startup without the client id, secret and
# redirect URI. AUTH_ISSUER_URL defaults to https://accounts.google.com. AUTH_CLIENT_SECRET is a Railway sealed
# variable. AUTH_REDIRECT_URI is https://<web domain>/auth/google/callback (the web origin proxies /auth to the api).
# AUTH_ALLOWED_DOMAINS: optional but strongly recommended, comma-separated Google Workspace domains (the `hd` claim);
# set = only those sign in.
AUTH_ISSUER_URL=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
AUTH_REDIRECT_URI=
AUTH_ALLOWED_DOMAINS=
# web: the api service on Railway's private network, e.g. http://api.railway.internal:3001 (Caddy reverse proxy
# for /trpc, /v1, /mcp, /auth and /health, so the app and the api share one origin and cookies are first-party)
API_INTERNAL_URL=
MODEL_ROUTING_POLICY_REF=
# ADR-11: the AI gateway. OREMEDIA_MODEL_ID is an OpenRouter model id (vendor/model) and is required with the key.
OPENROUTER_API_KEY_REF=
OREMEDIA_MODEL_ID=
# Direct Anthropic adapter, used only when OPENROUTER_API_KEY_REF is unset.
ANTHROPIC_API_KEY_REF=
# ADR-11 image generation (worker-core): set IMAGE_GEN_PROVIDER=openrouter with an OpenRouter image model id
# (a Nano Banana model); output enters asset ingest as a pending asset with generated provenance.
IMAGE_GEN_PROVIDER=
OREMEDIA_IMAGE_MODEL_ID=
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
LINK_REDIRECT_DOMAIN=
REVIEW_PORTAL_ORIGIN=
# per provider
PROVIDER_LINKEDIN_PAGE_CLIENT_ID_REF=
PROVIDER_LINKEDIN_PAGE_SECRET_REF=
TEMPORAL_API_KEY=
TEMPORAL_TLS_KEY_REF=
OUTBOX_POLL_INTERVAL_MS=
RENDER_CONCURRENCY=
MEDIA_CONCURRENCY=
RENDER_TIMEOUT_MS=
OREMEDIA_CHROMIUM_PATH=
OREMEDIA_RENDERER_BUNDLE=
TEMPORAL_TLS=
# Phase 5 publishing: local KMS master secret (development only; production uses KMS_KEY_ID_CREDENTIALS)
KMS_LOCAL_MASTER_SECRET=
CORE_CONCURRENCY=
PUBLISH_CONCURRENCY=
PROVIDER_FIXTURE_PROVIDER_CLIENT_ID_REF=
PROVIDER_FIXTURE_PROVIDER_SECRET_REF=
