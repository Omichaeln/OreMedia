{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "infra/railway/acceptance/Dockerfile",
    "watchPatterns": ["apps/**", "packages/**", "tooling/**", "pnpm-lock.yaml", "infra/railway/**"]
  },
  "deploy": {
    "restartPolicyType": "NEVER",
    "numReplicas": 1
  }
}
