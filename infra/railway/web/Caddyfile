{
	admin off
	auto_https off
	servers {
		# Railway's edge terminates TLS and forwards the client address; trust its X-Forwarded-For only from the
		# private and carrier-grade NAT ranges Railway's proxy connects from, so {client_ip} is the browser's.
		# Strict: the client IP is the right-most untrusted entry, so a value the browser put in X-Forwarded-For
		# (left of the edge's own entry) is never chosen. See the runbook: verify Railway appends to X-Forwarded-For.
		trusted_proxies static private_ranges 100.64.0.0/10
		trusted_proxies_strict
	}
}
:{$PORT:8080} {
	encode zstd gzip

	# D-03 same-site deployment: the API is reached through this origin, so the session and CSRF cookies are
	# first-party (*.up.railway.app subdomains are separate sites). API_INTERNAL_URL is the api service on Railway's
	# private network, e.g. http://api.railway.internal:3001. Unset, these paths answer 503 and the deploy health
	# check (/health, proxied) fails.
	@api path /trpc/* /v1/* /mcp /mcp/* /auth/* /health
	handle @api {
		reverse_proxy {$API_INTERNAL_URL} {
			header_up X-Forwarded-For {client_ip}
		}
	}

	# D-12: the deployment's brand pack (name, token stylesheet, logos), chosen at runtime by OREMEDIA_DEPLOYMENT_BRAND
	# from the packs the image carries (apps/web/deployment-brands), so one build serves every deployment. Unset, the
	# neutral pack; a key with no pack answers 404 and the app starts in the neutral brand.
	handle_path /deployment-brand/* {
		root * /deployment-brands/{$OREMEDIA_DEPLOYMENT_BRAND:oremedia}
		header {
			X-Content-Type-Options nosniff
			Cache-Control no-cache
			Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; img-src 'self' data:"
		}
		file_server
	}

	# The deployment's public legal pages (privacy policy, data deletion instructions), which the platform apps link
	# to, from the pack's legal/ directory as static HTML with clean URLs (/legal/privacy). A pack without them, or a
	# page it lacks, answers 404.
	handle_path /legal/* {
		root * /deployment-brands/{$OREMEDIA_DEPLOYMENT_BRAND:oremedia}/legal
		try_files {path}.html
		header {
			X-Content-Type-Options nosniff
			Referrer-Policy no-referrer
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			Cache-Control no-cache
			Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
		}
		file_server
	}

	# The object store's origin is allowed in two places, both for its short-lived signed URLs: font-src, because the
	# brand kit and the studio load a brand's own font files (pinned asset versions) as FontFace; and connect-src,
	# because browser uploads PUT straight to a signed upload URL (apps/web/src/features/assets/use-upload.ts).
	# OBJECT_STORE_PUBLIC_ORIGIN is that origin exactly as signed URLs carry it (scheme and host, no path), e.g.
	# https://<account>.r2.cloudflarestorage.com; unset, the browser refuses both, so uploads from the web app fail.
	handle {
		root * /srv
		header {
			X-Content-Type-Options nosniff
			Referrer-Policy no-referrer
			X-Frame-Options DENY
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com {$OBJECT_STORE_PUBLIC_ORIGIN}; img-src 'self' data: blob: https:; connect-src 'self' {$OBJECT_STORE_PUBLIC_ORIGIN}; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		}
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
