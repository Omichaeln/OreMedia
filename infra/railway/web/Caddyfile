{
	admin off
	auto_https off
	servers {
		# Railway's edge terminates TLS and forwards the client address; trust its X-Forwarded-For only from the
		# private and carrier-grade NAT ranges Railway's proxy connects from, so {client_ip} is the browser's.
		# Strict: the client IP is the right-most untrusted entry, so a value the browser put in X-Forwarded-For
		# (left of the edge's own entry) is never chosen. See the runbook: verify Railway appends to X-Forwarded-For.
		trusted_proxies static private_ranges 100.64.0.0/10
		trusted_proxies_strict
	}
}
:{$PORT:8080} {
	encode zstd gzip

	# D-03 same-site deployment: the API is reached through this origin, so the session and CSRF cookies are
	# first-party (*.up.railway.app subdomains are separate sites). API_INTERNAL_URL is the api service on Railway's
	# private network, e.g. http://api.railway.internal:3001. Unset, these paths answer 503 and the deploy health
	# check (/health, proxied) fails.
	@api path /trpc/* /v1/* /mcp /mcp/* /auth/* /health
	handle @api {
		reverse_proxy {$API_INTERNAL_URL} {
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle {
		root * /srv
		header {
			X-Content-Type-Options nosniff
			Referrer-Policy no-referrer
			X-Frame-Options DENY
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		}
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
