{
  "provider": "gbp_location",
  "scenarios": {
    "exchange": {
      "description": "Authorization code \u2192 access and refresh token with the business.manage scope granted.",
      "exchanges": [
        {
          "request": {
            "method": "POST",
            "host": "oauth2.googleapis.com",
            "path": "/token",
            "bodyIncludes": ["grant_type=authorization_code", "code=code_1", "code_verifier=v_1"]
          },
          "response": {
            "status": 200,
            "json": {
              "access_token": "ya29_at_1_fake",
              "expires_in": 3599,
              "refresh_token": "1//rt_1_fake",
              "scope": "https://www.googleapis.com/auth/business.manage openid",
              "token_type": "Bearer"
            }
          }
        }
      ]
    },
    "refresh_ok": {
      "exchanges": [
        {
          "request": {
            "method": "POST",
            "host": "oauth2.googleapis.com",
            "path": "/token",
            "bodyIncludes": ["grant_type=refresh_token", "refresh_token=1%2F%2Frt_1_fake"]
          },
          "response": {
            "status": 200,
            "json": {
              "access_token": "ya29_at_3_fake",
              "expires_in": 3599,
              "scope": "https://www.googleapis.com/auth/business.manage",
              "token_type": "Bearer"
            }
          }
        }
      ]
    },
    "refresh_revoked": {
      "exchanges": [
        {
          "request": {
            "method": "POST",
            "host": "oauth2.googleapis.com",
            "path": "/token"
          },
          "response": {
            "status": 400,
            "json": {
              "error": "invalid_grant",
              "error_description": "Token has been expired or revoked."
            }
          }
        }
      ]
    },
    "targets": {
      "description": "Two accounts over two pages; the first account's locations page twice, the second has none.",
      "exchanges": [
        {
          "request": {
            "method": "GET",
            "host": "mybusinessaccountmanagement.googleapis.com",
            "path": "/v1/accounts",
            "query": {
              "pageSize": "20"
            }
          },
          "response": {
            "status": 200,
            "json": {
              "accounts": [
                {
                  "name": "accounts/100",
                  "accountName": "Acme",
                  "type": "LOCATION_GROUP"
                }
              ],
              "nextPageToken": "a2"
            }
          }
        },
        {
          "request": {
            "method": "GET",
            "host": "mybusinessaccountmanagement.googleapis.com",
            "path": "/v1/accounts",
            "query": {
              "pageSize": "20",
              "pageToken": "a2"
            }
          },
          "response": {
            "status": 200,
            "json": {
              "accounts": [
                {
                  "name": "accounts/101",
                  "accountName": "Tar",
                  "type": "PERSONAL"
                }
              ]
            }
          }
        },
        {
          "request": {
            "method": "GET",
            "host": "mybusinessbusinessinformation.googleapis.com",
            "path": "/v1/accounts/100/locations",
            "query": {
              "readMask": "name,title,storefrontAddress",
              "pageSize": "100"
            }
          },
          "response": {
            "status": 200,
            "json": {
              "locations": [
                {
                  "name": "locations/777",
                  "title": "Acme Harare",
                  "storefrontAddress": {
                    "regionCode": "ZW",
                    "locality": "Harare",
                    "addressLines": ["12 Samora Machel Ave"]
                  }
                },
                {
                  "name": "locations/778",
                  "title": "Acme Bulawayo"
                }
              ],
              "nextPageToken": "l2"
            }
          }
        },
        {
          "request": {
            "method": "GET",
            "host": "mybusinessbusinessinformation.googleapis.com",
            "path": "/v1/accounts/100/locations",
            "query": {
              "readMask": "name,title,storefrontAddress",
              "pageSize": "100",
              "pageToken": "l2"
            }
          },
          "response": {
            "status": 200,
            "json": {
              "locations": [
                {
                  "name": "locations/779",
                  "title": "Acme Mutare",
                  "storefrontAddress": {
                    "regionCode": "ZW",
                    "locality": "Mutare"
                  }
                }
              ]
            }
          }
        },
        {
          "request": {
            "method": "GET",
            "host": "mybusinessbusinessinformation.googleapis.com",
            "path": "/v1/accounts/101/locations",
            "query": {
              "readMask": "name,title,storefrontAddress",
              "pageSize": "100"
            }
          },
          "response": {
            "status": 200,
            "json": {}
          }
        }
      ]
    },
    "targets_none": {
      "exchanges": [
        {
          "request": {
            "method": "GET",
            "host": "mybusinessaccountmanagement.googleapis.com",
            "path": "/v1/accounts"
          },
          "response": {
            "status": 200,
            "json": {
              "accounts": []
            }
          }
        }
      ]
    },
    "targets_forbidden": {
      "description": "The grant is refused for the account listing (scope missing or revoked): identity_failed.",
      "exchanges": [
        {
          "request": {
            "method": "GET",
            "host": "mybusinessaccountmanagement.googleapis.com",
            "path": "/v1/accounts"
          },
          "response": {
            "status": 403,
            "json": {
              "error": {
                "code": 403,
                "message": "Request had insufficient authentication scopes.",
                "status": "PERMISSION_DENIED"
              }
            }
          }
        }
      ]
    },
    "targets_access_required": {
      "description": "The Business Profile API is not enabled for the deployment's project: identity_failed, saying so.",
      "exchanges": [
        {
          "request": {
            "method": "GET",
            "host": "mybusinessaccountmanagement.googleapis.com",
            "path": "/v1/accounts"
          },
          "response": {
            "status": 403,
            "json": {
              "error": {
                "code": 403,
                "message": "My Business Account Management API has not been used in project 1234 before or it is disabled. Enable it by visiting the console then retry.",
                "status": "PERMISSION_DENIED",
                "details": [
                  {
                    "@type": "type.googleapis.com/google.rpc.ErrorInfo",
                    "reason": "SERVICE_DISABLED",
                    "domain": "googleapis.com",
                    "metadata": {
                      "service": "mybusinessaccountmanagement.googleapis.com"
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "revoke_ok": {
      "description": "Google revocation of the refresh token (RA-01).",
      "exchanges": [
        {
          "request": {
            "method": "POST",
            "host": "oauth2.googleapis.com",
            "path": "/revoke",
            "bodyIncludes": ["token=1%2F%2Frt_1_fake"]
          },
          "response": {
            "status": 200,
            "json": {}
          }
        }
      ]
    },
    "revoke_already_gone": {
      "description": "Google answers a token already revoked with 400 invalid_token: the access is gone.",
      "exchanges": [
        {
          "request": {
            "method": "POST",
            "host": "oauth2.googleapis.com",
            "path": "/revoke"
          },
          "response": {
            "status": 400,
            "json": {
              "error": "invalid_token",
              "error_description": "Token expired or revoked"
            }
          }
        }
      ]
    },
    "revoke_refused": {
      "description": "An outage during revocation is failed (the local disconnect goes ahead).",
      "exchanges": [
        {
          "request": {
            "method": "POST",
            "host": "oauth2.googleapis.com",
            "path": "/revoke"
          },
          "response": {
            "status": 503,
            "json": {
              "error": "unavailable"
            }
          }
        }
      ]
    }
  }
}
