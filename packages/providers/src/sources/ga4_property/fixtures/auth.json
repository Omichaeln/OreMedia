{
  "provider": "ga4_property",
  "scenarios": {
    "exchange": {
      "description": "Authorization code → access and refresh token with the granted scopes.",
      "exchanges": [
        {
          "request": {
            "method": "POST",
            "host": "oauth2.googleapis.com",
            "path": "/token",
            "bodyIncludes": ["grant_type=authorization_code", "code=code_1", "code_verifier=v_1"]
          },
          "response": {
            "status": 200,
            "json": {
              "access_token": "ya29_at_1_fake",
              "expires_in": 3599,
              "refresh_token": "1//rt_1_fake",
              "scope": "https://www.googleapis.com/auth/analytics.readonly openid",
              "token_type": "Bearer"
            }
          }
        }
      ]
    },
    "exchange_without_refresh_token": {
      "description": "A returning consent without prompt=consent issues no refresh token: the grant is refused.",
      "exchanges": [
        {
          "request": { "method": "POST", "host": "oauth2.googleapis.com", "path": "/token" },
          "response": {
            "status": 200,
            "json": { "access_token": "ya29_at_2_fake", "expires_in": 3599, "token_type": "Bearer" }
          }
        }
      ]
    },
    "refresh_ok": {
      "exchanges": [
        {
          "request": {
            "method": "POST",
            "host": "oauth2.googleapis.com",
            "path": "/token",
            "bodyIncludes": ["grant_type=refresh_token", "refresh_token=1%2F%2Frt_1_fake"]
          },
          "response": {
            "status": 200,
            "json": {
              "access_token": "ya29_at_3_fake",
              "expires_in": 3599,
              "scope": "https://www.googleapis.com/auth/analytics.readonly",
              "token_type": "Bearer"
            }
          }
        }
      ]
    },
    "refresh_revoked": {
      "exchanges": [
        {
          "request": {
            "method": "POST",
            "host": "oauth2.googleapis.com",
            "path": "/token",
            "bodyIncludes": ["grant_type=refresh_token"]
          },
          "response": {
            "status": 400,
            "json": { "error": "invalid_grant", "error_description": "Token has been expired or revoked." }
          }
        }
      ]
    },
    "refresh_invalid_client": {
      "description": "A wrong client secret: the grant is intact, the deployment is misconfigured (transient).",
      "exchanges": [
        {
          "request": { "method": "POST", "host": "oauth2.googleapis.com", "path": "/token" },
          "response": {
            "status": 401,
            "json": { "error": "invalid_client", "error_description": "The OAuth client was not found." }
          }
        }
      ]
    },
    "refresh_throttled": {
      "exchanges": [
        {
          "request": { "method": "POST", "host": "oauth2.googleapis.com", "path": "/token" },
          "response": { "status": 429, "json": { "error": "rate_limit_exceeded" } }
        }
      ]
    },
    "refresh_outage": {
      "exchanges": [
        {
          "request": { "method": "POST", "host": "oauth2.googleapis.com", "path": "/token" },
          "response": { "status": 503, "json": { "error": "backend_error" } }
        }
      ]
    },
    "targets": {
      "description": "Two accounts over two pages; the second account has no property.",
      "exchanges": [
        {
          "request": {
            "method": "GET",
            "host": "analyticsadmin.googleapis.com",
            "path": "/v1beta/accountSummaries",
            "query": { "pageSize": "200" }
          },
          "response": {
            "status": 200,
            "json": {
              "accountSummaries": [
                {
                  "name": "accountSummaries/100",
                  "account": "accounts/100",
                  "displayName": "Acme",
                  "propertySummaries": [
                    {
                      "property": "properties/424242",
                      "displayName": "Acme web",
                      "propertyType": "PROPERTY_TYPE_ORDINARY"
                    },
                    {
                      "property": "properties/424243",
                      "displayName": "Acme app",
                      "propertyType": "PROPERTY_TYPE_ORDINARY"
                    }
                  ]
                },
                { "name": "accountSummaries/101", "account": "accounts/101", "displayName": "Empty" }
              ],
              "nextPageToken": "p2"
            }
          }
        },
        {
          "request": {
            "method": "GET",
            "host": "analyticsadmin.googleapis.com",
            "path": "/v1beta/accountSummaries",
            "query": { "pageSize": "200", "pageToken": "p2" }
          },
          "response": {
            "status": 200,
            "json": {
              "accountSummaries": [
                {
                  "name": "accountSummaries/102",
                  "account": "accounts/102",
                  "displayName": "Tar",
                  "propertySummaries": [{ "property": "properties/555", "displayName": "Tar site" }]
                }
              ]
            }
          }
        }
      ]
    },
    "targets_none": {
      "exchanges": [
        {
          "request": {
            "method": "GET",
            "host": "analyticsadmin.googleapis.com",
            "path": "/v1beta/accountSummaries"
          },
          "response": { "status": 200, "json": {} }
        }
      ]
    },
    "targets_forbidden": {
      "exchanges": [
        {
          "request": {
            "method": "GET",
            "host": "analyticsadmin.googleapis.com",
            "path": "/v1beta/accountSummaries"
          },
          "response": {
            "status": 403,
            "json": {
              "error": {
                "code": 403,
                "message": "Request had insufficient authentication scopes.",
                "status": "PERMISSION_DENIED"
              }
            }
          }
        }
      ]
    }
  }
}
