{
  "provider": "search_console_site",
  "scenarios": {
    "exchange": {
      "exchanges": [
        {
          "request": {
            "method": "POST",
            "host": "oauth2.googleapis.com",
            "path": "/token",
            "bodyIncludes": ["grant_type=authorization_code", "code=code_1", "code_verifier=v_1"]
          },
          "response": {
            "status": 200,
            "json": {
              "access_token": "ya29_at_1_fake",
              "expires_in": 3599,
              "refresh_token": "1//rt_1_fake",
              "scope": "https://www.googleapis.com/auth/webmasters.readonly",
              "token_type": "Bearer"
            }
          }
        }
      ]
    },
    "refresh_ok": {
      "exchanges": [
        {
          "request": {
            "method": "POST",
            "host": "oauth2.googleapis.com",
            "path": "/token",
            "bodyIncludes": ["grant_type=refresh_token", "refresh_token=1%2F%2Frt_1_fake"]
          },
          "response": {
            "status": 200,
            "json": {
              "access_token": "ya29_at_3_fake",
              "expires_in": 3599,
              "token_type": "Bearer"
            }
          }
        }
      ]
    },
    "refresh_revoked": {
      "exchanges": [
        {
          "request": {
            "method": "POST",
            "host": "oauth2.googleapis.com",
            "path": "/token"
          },
          "response": {
            "status": 400,
            "json": {
              "error": "invalid_grant"
            }
          }
        }
      ]
    },
    "targets": {
      "description": "Three entries: a URL-prefix site, a domain property and an unverified site that is left out.",
      "exchanges": [
        {
          "request": {
            "method": "GET",
            "host": "www.googleapis.com",
            "path": "/webmasters/v3/sites"
          },
          "response": {
            "status": 200,
            "json": {
              "siteEntry": [
                {
                  "siteUrl": "https://acme.example/",
                  "permissionLevel": "siteOwner"
                },
                {
                  "siteUrl": "sc-domain:tar.example",
                  "permissionLevel": "siteFullUser"
                },
                {
                  "siteUrl": "https://pending.example/",
                  "permissionLevel": "siteUnverifiedUser"
                }
              ]
            }
          }
        }
      ]
    },
    "targets_unauthorised": {
      "exchanges": [
        {
          "request": {
            "method": "GET",
            "host": "www.googleapis.com",
            "path": "/webmasters/v3/sites"
          },
          "response": {
            "status": 401,
            "json": {
              "error": {
                "code": 401,
                "message": "Invalid Credentials",
                "status": "UNAUTHENTICATED"
              }
            }
          }
        }
      ]
    },
    "targets_throttled": {
      "exchanges": [
        {
          "request": {
            "method": "GET",
            "host": "www.googleapis.com",
            "path": "/webmasters/v3/sites"
          },
          "response": {
            "status": 429,
            "headers": {
              "retry-after": "30"
            },
            "json": {
              "error": {
                "code": 429
              }
            }
          }
        }
      ]
    },
    "revoke_ok": {
      "description": "Google revocation of the refresh token (RA-01).",
      "exchanges": [
        {
          "request": {
            "method": "POST",
            "host": "oauth2.googleapis.com",
            "path": "/revoke",
            "bodyIncludes": ["token=1%2F%2Frt_1_fake"]
          },
          "response": {
            "status": 200,
            "json": {}
          }
        }
      ]
    },
    "revoke_already_gone": {
      "description": "Google answers a token already revoked with 400 invalid_token: the access is gone.",
      "exchanges": [
        {
          "request": {
            "method": "POST",
            "host": "oauth2.googleapis.com",
            "path": "/revoke"
          },
          "response": {
            "status": 400,
            "json": {
              "error": "invalid_token",
              "error_description": "Token expired or revoked"
            }
          }
        }
      ]
    },
    "revoke_refused": {
      "description": "An outage during revocation is failed (the local disconnect goes ahead).",
      "exchanges": [
        {
          "request": {
            "method": "POST",
            "host": "oauth2.googleapis.com",
            "path": "/revoke"
          },
          "response": {
            "status": 503,
            "json": {
              "error": "unavailable"
            }
          }
        }
      ]
    }
  }
}
