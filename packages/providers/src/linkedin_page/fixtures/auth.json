{
  "provider": "linkedin_page",
  "scenarios": {
    "exchange": {
      "description": "Authorization code \u2192 token \u2192 OIDC userinfo \u2192 administered organisations (two eligible, one ANALYST ignored).",
      "exchanges": [
        {
          "request": {
            "method": "POST",
            "host": "www.linkedin.com",
            "path": "/oauth/v2/accessToken",
            "bodyIncludes": ["grant_type=authorization_code", "code=code_1"]
          },
          "response": {
            "status": 200,
            "json": {
              "access_token": "at_1_fake",
              "expires_in": 5183999,
              "refresh_token": "rt_1_fake",
              "refresh_token_expires_in": 31536000,
              "scope": "openid,profile,w_organization_social,r_organization_social,rw_organization_admin"
            }
          }
        },
        {
          "request": {
            "method": "GET",
            "host": "api.linkedin.com",
            "path": "/v2/userinfo"
          },
          "response": {
            "status": 200,
            "json": {
              "sub": "m_ada",
              "name": "Ada Lovelace"
            }
          }
        },
        {
          "request": {
            "method": "GET",
            "host": "api.linkedin.com",
            "path": "/rest/organizationAcls",
            "query": {
              "q": "roleAssignee",
              "state": "APPROVED"
            }
          },
          "response": {
            "status": 200,
            "json": {
              "elements": [
                {
                  "organization": "urn:li:organization:2002",
                  "role": "CONTENT_ADMINISTRATOR",
                  "state": "APPROVED",
                  "organization~": {
                    "localizedName": "Tar Studio",
                    "vanityName": "tar-studio"
                  }
                },
                {
                  "organization": "urn:li:organization:2001",
                  "role": "ADMINISTRATOR",
                  "state": "APPROVED",
                  "organization~": {
                    "localizedName": "Ore Media",
                    "vanityName": "ore-media"
                  }
                },
                {
                  "organization": "urn:li:organization:2003",
                  "role": "ANALYST",
                  "state": "APPROVED",
                  "organization~": {
                    "localizedName": "Read Only Co"
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "refresh_ok": {
      "exchanges": [
        {
          "request": {
            "method": "POST",
            "host": "www.linkedin.com",
            "path": "/oauth/v2/accessToken",
            "bodyIncludes": ["grant_type=refresh_token", "refresh_token=rt_1_fake"]
          },
          "response": {
            "status": 200,
            "json": {
              "access_token": "at_2_fake",
              "expires_in": 5183999,
              "refresh_token": "rt_2_fake",
              "refresh_token_expires_in": 31000000
            }
          }
        }
      ]
    },
    "refresh_revoked": {
      "exchanges": [
        {
          "request": {
            "method": "POST",
            "host": "www.linkedin.com",
            "path": "/oauth/v2/accessToken",
            "bodyIncludes": ["grant_type=refresh_token"]
          },
          "response": {
            "status": 400,
            "json": {
              "error": "invalid_grant",
              "error_description": "The provided authorization grant or refresh token is invalid, expired or revoked."
            }
          }
        }
      ]
    },
    "revoke_ok": {
      "description": "Token revocation (RA-01): client id, secret and the access token, form-encoded.",
      "exchanges": [
        {
          "request": {
            "method": "POST",
            "host": "www.linkedin.com",
            "path": "/oauth/v2/revoke",
            "bodyIncludes": ["client_id=cid", "token=at_1_fake"]
          },
          "response": {
            "status": 200,
            "body": ""
          }
        }
      ]
    },
    "revoke_refused": {
      "description": "A revocation the platform refuses: recorded as failed with the status.",
      "exchanges": [
        {
          "request": {
            "method": "POST",
            "host": "www.linkedin.com",
            "path": "/oauth/v2/revoke"
          },
          "response": {
            "status": 400,
            "json": {
              "error": "invalid_request",
              "error_description": "A required parameter \"token\" is missing"
            }
          }
        }
      ]
    }
  }
}
