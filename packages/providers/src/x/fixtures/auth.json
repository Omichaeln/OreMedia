{
  "provider": "x",
  "scenarios": {
    "exchange": {
      "exchanges": [
        {
          "request": {
            "method": "POST",
            "host": "api.x.com",
            "path": "/2/oauth2/token",
            "bodyIncludes": ["grant_type=authorization_code", "code=code_1", "code_verifier=verifier_xyz"]
          },
          "response": {
            "status": 200,
            "json": {
              "token_type": "bearer",
              "expires_in": 7200,
              "access_token": "xat_1_fake",
              "scope": "tweet.read tweet.write users.read offline.access media.write",
              "refresh_token": "xrt_1_fake"
            }
          }
        },
        {
          "request": {
            "method": "GET",
            "host": "api.x.com",
            "path": "/2/users/me",
            "query": {
              "user.fields": "username,name"
            }
          },
          "response": {
            "status": 200,
            "json": {
              "data": {
                "id": "u_42",
                "name": "Ore Media",
                "username": "oremedia"
              }
            }
          }
        }
      ]
    },
    "refresh_ok": {
      "exchanges": [
        {
          "request": {
            "method": "POST",
            "host": "api.x.com",
            "path": "/2/oauth2/token",
            "bodyIncludes": ["grant_type=refresh_token", "refresh_token=xrt_1_fake"]
          },
          "response": {
            "status": 200,
            "json": {
              "token_type": "bearer",
              "expires_in": 7200,
              "access_token": "xat_2_fake",
              "refresh_token": "xrt_2_fake",
              "scope": "tweet.read tweet.write users.read offline.access media.write"
            }
          }
        }
      ]
    },
    "refresh_revoked": {
      "exchanges": [
        {
          "request": {
            "method": "POST",
            "host": "api.x.com",
            "path": "/2/oauth2/token"
          },
          "response": {
            "status": 400,
            "json": {
              "error": "invalid_request",
              "error_description": "Value passed for the token was invalid."
            }
          }
        }
      ]
    },
    "revoke_ok": {
      "description": "RFC 7009 revocation of the refresh token as the confidential client (RA-01).",
      "exchanges": [
        {
          "request": {
            "method": "POST",
            "host": "api.x.com",
            "path": "/2/oauth2/revoke",
            "bodyIncludes": ["token=xrt_1_fake", "token_type_hint=refresh_token"]
          },
          "response": {
            "status": 200,
            "json": {
              "revoked": true
            }
          }
        }
      ]
    },
    "revoke_refused": {
      "description": "The platform refuses the revocation (a misconfigured client): recorded as failed.",
      "exchanges": [
        {
          "request": {
            "method": "POST",
            "host": "api.x.com",
            "path": "/2/oauth2/revoke"
          },
          "response": {
            "status": 401,
            "json": {
              "title": "Unauthorized",
              "detail": "Unauthorized",
              "type": "about:blank",
              "status": 401
            }
          }
        }
      ]
    }
  }
}
