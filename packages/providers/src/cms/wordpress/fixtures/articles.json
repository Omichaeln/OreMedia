{
  "provider": "cms_site",
  "scenarios": {
    "verify_ok": {
      "description": "The application password authenticates an editor who can publish.",
      "exchanges": [
        {
          "request": {
            "method": "GET",
            "host": "site.example",
            "path": "/wp-json/wp/v2/users/me",
            "query": { "context": "edit" }
          },
          "response": {
            "status": 200,
            "json": {
              "id": 7,
              "name": "Ore Editor",
              "slug": "ore-editor",
              "capabilities": { "edit_posts": true, "publish_posts": true }
            }
          }
        }
      ]
    },
    "verify_unauthorised": {
      "exchanges": [
        {
          "request": { "method": "GET", "host": "site.example", "path": "/wp-json/wp/v2/users/me" },
          "response": {
            "status": 401,
            "json": {
              "code": "rest_not_logged_in",
              "message": "You are not currently logged in.",
              "data": { "status": 401 }
            }
          }
        }
      ]
    },
    "verify_subscriber": {
      "exchanges": [
        {
          "request": { "method": "GET", "host": "site.example", "path": "/wp-json/wp/v2/users/me" },
          "response": {
            "status": 200,
            "json": { "id": 9, "name": "Reader", "capabilities": { "read": true } }
          }
        }
      ]
    },
